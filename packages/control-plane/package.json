{
  "name": "@adaptive-router/control-plane",
  "version": "0.1.0",
  "description": "Self-hostable multi-tenant team control plane for Adaptive Model Router — organizations, projects, Better-Auth login, Postgres persistence, and project-scoped dashboards.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adaptive-control-plane": "dist/server.js"
  },
  "files": [
    "dist",
    "deploy",
    "deploy/.env.example",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guangyang1206/adaptive-model-router.git",
    "directory": "packages/control-plane"
  },
  "homepage": "https://github.com/guangyang1206/adaptive-model-router#readme",
  "bugs": {
    "url": "https://github.com/guangyang1206/adaptive-model-router/issues"
  },
  "keywords": [
    "llm",
    "model-router",
    "control-plane",
    "multi-tenant",
    "self-hosted",
    "postgres",
    "better-auth"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-migrations.mjs && chmod +x dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@adaptive-router/sdk": "workspace:*",
    "@adaptive-router/dashboard": "workspace:*",
    "better-auth": "^1.2.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
