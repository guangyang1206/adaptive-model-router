{
  "name": "@adaptive-router/cli",
  "version": "0.1.0",
  "description": "Developer CLI for Adaptive Model Router — init config, check provider env, inspect traces, export diagnostics, run the eval harness.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "adaptive-router": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guangyang1206/adaptive-model-router.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/guangyang1206/adaptive-model-router#readme",
  "bugs": {
    "url": "https://github.com/guangyang1206/adaptive-model-router/issues"
  },
  "keywords": [
    "llm",
    "model-router",
    "cli",
    "agent",
    "eval",
    "tracing"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && chmod +x dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adaptive-router/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
